{
  "name": "ds-ai-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Пилот: генерация UI агентом по промпту и макету с опорой на дизайн-систему (Figma MCP + Code Connect + Storybook MCP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "style-dictionary build --config tokens/sd.config.mjs",
    "figma:connect:publish": "figma connect publish",
    "figma:connect:parse": "figma connect parse",
    "test:tools": "node --test --import tsx eval/tools/*.test.ts && node --test eslint/plugin-ds.test.js",
    "eval:config": "tsx eval/scripts/set-config.ts",
    "eval:prompt": "tsx eval/scripts/prompt.ts",
    "eval:manifest": "tsx eval/scripts/build-manifest.ts",
    "eval:analyze": "tsx eval/scripts/analyze.ts",
    "eval:a11y": "playwright test -c eval/a11y/playwright.config.ts",
    "eval:report": "tsx eval/scripts/report.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@figma/code-connect": "^1.3.0",
    "@playwright/test": "^1.50.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-mcp": "latest",
    "@storybook/react-vite": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
